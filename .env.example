# =============================================================================
# GusVoice — example environment. Copy to `.env` and fill in real values.
# NEVER commit a real .env (it is gitignored). This file holds placeholders only.
#
# For a turnkey install, run `./install.sh` — it generates all secrets and writes
# this file for you. Edit by hand only for advanced/custom setups.
#
# Generate strong secrets manually, e.g.:
#   openssl rand -hex 32
# =============================================================================

# ---- Base domain (turnkey) ------------------------------------------------
# Your domain; subdomains (or paths, in single-name mode) are derived from it.
#   e.g. BASE_DOMAIN=example.com  ->  voice/api/presence/lk/media/ntfy.example.com
BASE_DOMAIN=example.com
# ACME e-mail for Let's Encrypt when using the bundled Caddy (profile "caddy").
ACME_EMAIL=admin@example.com

# ---- Postgres -------------------------------------------------------------
POSTGRES_USER=gusvoice
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=gusvoice

# ---- App auth (backend JWT signing) --------------------------------------
JWT_SECRET=change-me-with-openssl-rand-hex-32

# ---- Первичная настройка ---------------------------------------------------
# Код установки (install.sh генерирует его и печатает в конце). Пока супер-админа нет, сайт
# https://voice.<домен> открывает мастер настройки ТОЛЬКО по этому коду: админ, название, почта,
# кто может регистрироваться, первый сервер. После создания админа код гаснет. Пусто — мастера нет.
SETUP_TOKEN=

# ---- Super-admin (для автоматических установок; обычно пусто — админа создаёт мастер) ----
# Логин аккаунта, который станет супер-админом (полный доступ к инстансу + админ-панель).
# Права привязываются к id этого аккаунта при первом старте; после привязки смена значения
# права НЕ переносит. Пусто — супер-админа нет.
SUPERADMIN_USERNAME=
# First-boot bootstrap: if USERNAME + EMAIL + PASSWORD are ALL set, the backend seeds a PRE-VERIFIED
# super-admin on startup (idempotent — skipped if it already exists), so you log in immediately with no
# web signup / e-mail code. install.sh fills these in. Safe to blank PASSWORD after the first login.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Where operational alerts (brute-force lockouts) are emailed. Empty => the super-admin's own address.
ADMIN_EMAIL=

# ---- Anti-bot registration -----------------------------------------------
# A bot that registers but never verifies otherwise squats the username forever. Abandoned
# unverified accounts with zero activity are purged after this many days (0 = never).
UNVERIFIED_TTL_DAYS=7
# Instance-wide signups per hour, on top of the per-IP limit. Caps IP-rotating botnets.
REGISTER_GLOBAL_MAX=100

# ---- Media storage (S3) --------------------------------------------------
# Holds avatars/attachments/sounds/icons in one public-read bucket. Any S3 works; the
# names say MINIO_* for historical reasons. With the bundled storage (compose profile
# "storage", versitygw) set MINIO_ENDPOINT=minio (or storage — both names answer) and
# MINIO_PUBLIC_URL to the public media host; the access/secret key become its root key.
# Leave MINIO_ENDPOINT empty to disable uploads entirely.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=gusvoice
# Base URL browsers load media from, e.g. https://media.example.com
MINIO_PUBLIC_URL=

# ---- Email verification (SMTP) -------------------------------------------
# Registration emails a 6-digit code via this SMTP server. Leave SMTP_HOST empty to
# disable email and log codes to the backend instead.
#   SMTP_SECURE=true for port 465 (implicit TLS); false for 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=change-me-smtp-password
MAIL_FROM=GusVoice <noreply@example.com>

# ---- Push notifications (UnifiedPush / self-hosted ntfy) ------------------
# DMs + @mentions wake the mobile app in the background via a self-hosted ntfy gateway
# (no Google/FCM). With the bundled ntfy (compose profile "push") point these at it.
# Leave NTFY_BASE_URL empty to disable push. NTFY_TOKEN is a write-only publish token.
#   e.g. NTFY_BASE_URL=https://ntfy.example.com
NTFY_BASE_URL=
NTFY_TOKEN=

# ---- Tauri updater feed (optional) ---------------------------------------
# Where /download reads the current desktop installer URL. For the public project the
# clients + updater live on GitHub Releases. Empty => /download returns 503.
UPDATE_FEED_URL=

# Where the admin panel's "Instance" tab learns the newest GusVoice release (only while the super-admin has it
# open, cached for 6 h). Unset => the project's GitHub releases; set it EMPTY to turn the check off.
# GV_RELEASES_URL=

# ---- LiveKit credentials --------------------------------------------------
# LIVEKIT_API_KEY is a key *name*, not a secret — it must match `webhook.api_key`
# in config/livekit.yaml. The secret below IS sensitive; generate a random one.
LIVEKIT_API_KEY=gusvoice
LIVEKIT_API_SECRET=change-me-with-openssl-rand-hex-32

# Internal URL is used by backend/presence to call the LiveKit API over the docker
# network. The EXTERNAL URL is handed to browsers for the wss:// signaling connection.
#   local dev : ws://localhost:7880
#   production: wss://lk.example.com
LIVEKIT_URL_EXTERNAL=ws://localhost:7880

# ---- Public client-facing URLs (consumed by the web client at runtime) ----
# Where the browser reaches the backend REST/WS, the presence WS, and (for the
# discovery doc) the push gateway. These are also served at /config.json so the
# generic desktop/mobile client can point itself at this instance.
#   local dev : http://localhost:4000  /  ws://localhost:4001
#   production: https://api.example.com  /  wss://presence.example.com
VITE_API_URL=http://localhost:4000
VITE_PRESENCE_WS=ws://localhost:4001
# Public ntfy base for the discovery doc (embedded push distributor). Usually same as NTFY_BASE_URL.
VITE_PUSH_GATEWAY=

# Allowed browser origin for CORS on the backend/presence services.
#   local dev : http://localhost:8080
#   production: https://voice.example.com
CLIENT_ORIGIN=http://localhost:8080

# ---- Image registry (CI / deploy) ----------------------------------------
# For local builds the defaults are fine. To deploy prebuilt images point these at
# a container registry, e.g. REGISTRY=ghcr.io/<owner>/gusvoice  TAG=latest
REGISTRY=gusvoice
TAG=local

# Host interface the reverse-proxied services bind to. Default 127.0.0.1 (local dev /
# proxy on the same host). Set 0.0.0.0 when the proxy runs on a different host.
BIND_ADDR=127.0.0.1

# ---- Импорт стикеров из Telegram (#68) -----------------------------------
# Токен бота от @BotFather. Пусто => вкладка «Стикеры» скажет, что импорт не настроен.
# Бот подойдёт ЛЮБОЙ: набор читается публичным методом getStickerSet, состоять
# в чатах и что-либо принимать ему не требуется.
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Диагностика с машин пользователей (#113)
# ---------------------------------------------------------------------------
# Приложение собирает счётчики (видеокарта, память, показ экрана) и шлёт их НА ЭТОТ сервер, чтобы
# владелец инстанса мог разобрать жалобу «у меня лагает» по числам, а не по догадкам.
#
# Выключено по умолчанию и включается ОСОЗНАННО: это данные о машинах ваших людей. Включив, скажите
# им об этом — приложение спросит согласия само, но узнать о самом факте сбора они должны от вас.
# Полный перечень собираемого — в docs/ и в самом окне согласия.
#
# Выключено => маршруты /api/diag/* не существуют (404), клиент ничего не собирает.
DIAG_ENABLED=false

# ---------------------------------------------------------------------------
# Статистика присутствия в голосе (экономика GusCoins, шаг 0 — «сухой прогон»)
# ---------------------------------------------------------------------------
# Сервер копит СЫРЫЕ факты: сколько секунд человек был в голосовом канале, сколько людей было рядом,
# был ли он в мьюте. Монеты по этим данным НЕ начисляются и никому не показываются — числа экономики
# (ставку, потолок, цены) назначают уже потом, по накопленной картине. План — docs/guscoins-plan.md.
#
# Выключено по умолчанию и включается ОСОЗНАННО: это данные о том, кто сколько часов сидит в войсе.
# Включив, скажите об этом своим людям.
#
# Выключено => сборщик не запускается вовсе, таблица voice_activity остаётся пустой.
ECONOMY_STATS_ENABLED=false

# --- Экономика ГусКоинов: сама фича (#117) ---
# Выключено => маршрутов /servers/:id/economy/* НЕТ, и вкладку «Монеты» в настройках сервера не
# видит НИКТО, включая владельца. То есть на инстансе экономики просто не существует.
#
# 🔴 Это ДРУГОЙ флаг, чем ECONOMY_STATS_ENABLED выше, и они не заменяют друг друга. Сбор статистики
# нужен ДО экономики: по накопленным секундам и назначаются ставка, потолок и цены. Нормальный
# порядок — сначала неделя со STATS=true и ENABLED=false, потом уже включать саму экономику.
#
# ⚠️ Тумблер «включить экономику» внутри вкладки боевой: с ENABLED=true владелец ЛЮБОГО сервера на
# этом инстансе может запустить начисление у себя. Пока фича не доделана, флаг держим выключенным.
ECONOMY_ENABLED=false
# Закрытый показ экономики: идентификаторы через запятую, кому она видна на включённом инстансе.
# Пусто = ограничения нет. Нужен, пока фича обкатывается: флаг выше открывает вкладку «Монеты»
# КАЖДОМУ владельцу сервера, а выключатель сервера — всем его участникам.
ECONOMY_PREVIEW_USERS=
