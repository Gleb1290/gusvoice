# Пример окружения бота. Скопируйте в файл вне репозитория (например /etc/my-bot/env или .env рядом с compose),
# впишите свои значения, права 600. Реальные значения в репозиторий не кладём.
# Адрес вашего инстанса GusVoice (по нему SDK найдёт адрес API через /config.json).
GUSVOICE_URL=https://voice.example.com
# Токен бота (Настройки -> Мои боты). Показывается один раз; при утечке — «Перевыпустить токен».
GUSVOICE_BOT_TOKEN=
# Через запятую: id людей, которым бот подчиняется (vps-panel.ts). Свой id покажет команда /whoami.
OWNER_IDS=
# vps-panel.ts: какие службы можно перезапускать.
RESTART_SERVICES=
# ws (по умолчанию, Node 22+) или polling.
MODE=ws
# webhook-node.ts:
# PUBLIC_URL=https://bot.example.com/hook
# HOOK_SECRET=
