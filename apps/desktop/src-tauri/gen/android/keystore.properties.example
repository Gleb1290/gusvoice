# Android RELEASE signing for RuStore.
# Copy this file to `keystore.properties` (gitignored) and fill in the two passwords.
# Alternatively, set env vars (used by Gitea CI): ANDROID_KEYSTORE_PATH / ANDROID_KEYSTORE_PASSWORD /
# ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD. build.gradle.kts prefers keystore.properties, then env.
#
# storeFile: absolute path, or relative to gen/android/. The real key lives off-repo in S:\gusvoice-keys.
storeFile=S:/gusvoice-keys/gusvoice-release.keystore
keyAlias=gusvoice
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
