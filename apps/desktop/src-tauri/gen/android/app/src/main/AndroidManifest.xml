<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice + camera in LiveKit WebRTC (getUserMedia inside the WebView). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Keep the voice call alive when the screen locks / app is backgrounded (#89). FGS_MICROPHONE
         (API 34+) requires RECORD_AUDIO (above); POST_NOTIFICATIONS (API 33+) shows the FGS notice.
         FGS_MEDIA_PLAYBACK: the mic type only tells the OS we RECORD in the background (upstream) — it
         does NOT protect audio OUTPUT, so aggressive OEMs (Xiaomi/MIUI/HyperOS, Oppo, Vivo) suspend
         background playback ~40s after backgrounding and remote voices go silent while the mic keeps
         flowing. Declaring mediaPlayback too tells the OS we also PLAY audio in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Embedded push distributor: a data-sync FGS holds the socket to the instance's ntfy so DMs /
         @mentions wake the app when it's closed, with no separate distributor app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- #212: на Android 14+ служба пушей — `specialUse`. У `dataSync` с Android 15 лимит 6 часов в сутки
         (потом `onTimeout`, не остановился — процесс падает) и запрет старта после перезагрузки;
         у `specialUse` нет ни того, ни другого. `dataSync` остаётся для Android 10–13. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- #212: вибро-отклик. Chromium в WebView без этого разрешения молча игнорирует `navigator.vibrate`. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- G73: входящий звонок поверх экрана (`CallNotifier`, как у Telegram). Android 14+ даёт его не всем — проверка
         `canUseFullScreenIntent`, без него уведомление звонка всплывает обычным heads-up. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Своя галерея во вложениях (05.10, MediaBridge.kt): фото и видео устройства. Android 13+ — READ_MEDIA_IMAGES/VIDEO,
         Android 14+ — ещё частичный доступ (человек выбирает, какие фото видно приложению), ниже 13 — чтение памяти.
         Спрашиваются при первом открытии галереи, не на старте. Запись в галерею («Сохранить», Android 10+) своих файлов
         разрешения не требует — WRITE_EXTERNAL_STORAGE не нужен. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- Mic/camera are optional features so the app isn't filtered off devices that lack them. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.gusvoice"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Ссылка-приглашение из мессенджера (#139, F4, §4.2.2): страница `/i/<код>` на хосте
                 вызывает `gusvoice://join?invite=…`, и сюда приходит уже запущенное приложение
                 (singleTask → onNewIntent) или холодный старт.
                 🔴 Своя СХЕМА, а не App Links по https: те требуют перечислить домены при сборке и
                 положить assetlinks.json на каждом — а домены инстансов друзей нам заранее
                 неизвестны. Схема работает для любого инстанса.
                 ⚠️ BROWSABLE обязателен: без него браузер ссылку нам не отдаст. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gusvoice" />
            </intent-filter>
            <!-- «Поделиться в GusVoice» (09.10, G79): системное «Поделиться» из галереи, браузера, «Файлов» → выбор беседы в
                 клиенте → вложения и текст в её поле (ничего не уходит без нажатия). Набор типов — как у Telegram Android
                 (`AndroidManifest.xml` у `LaunchActivity`). Разбор — `ShareIntent.kt`, копия байтов — `MediaBridge.onShareIntent`;
                 singleTask → в запущенное приложение приходит через `onNewIntent`. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Voice-call foreground service (#89). Not exported — only our own JS bridge starts it.
             Dual type: microphone (keep recording in bg) + mediaPlayback (keep OUR audio OUTPUT alive
             in bg so aggressive OEMs don't mute remote voices ~40s after backgrounding). -->
        <service
            android:name=".VoiceForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

        <!-- UnifiedPush receiver — the ntfy distributor broadcasts push events here (DM / @mention wake),
             firing even when GusVoice's own process is dead. Exported so the external distributor reaches it.
             Declaring it with the proper intent-filter makes the connector library use THIS receiver. -->
        <receiver
            android:name=".UnifiedPushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
            </intent-filter>
        </receiver>

        <!-- Embedded push distributor: foreground service holding the WebSocket to the instance's ntfy
             (the multi-instance path — no separate ntfy app). Not exported; started from our JS bridge. -->
        <service
            android:name=".PushDistributorService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <!-- Объяснение `specialUse` для системы (и магазинов): постоянное соединение с сервером
                 уведомлений самого приложения, без стороннего сервиса пушей. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds the connection to the app's own push server (UnifiedPush) so messages arrive while the app is closed" />
        </service>

        <!-- Действия уведомления беседы (Р1, G17): «Ответить» из шторки, «Прочитано», смахивание. Только наши PendingIntent. -->
        <receiver
            android:name=".NotifActionReceiver"
            android:exported="false" />

        <!-- Входящий звонок (G73): полноэкранный экран поверх блокировки (`fullScreenIntent` уведомления CALL) и
             «Отклонить» без открытия приложения. Своя задача (`taskAffinity` пустой), не в «Недавних»: закрылся —
             под ним блокировка, а не приложение. Не экспортированы: открывают только наши PendingIntent. -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.gusvoice" />
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

        <!-- Restart the embedded push distributor after reboot (only if it was enabled). -->
        <receiver
            android:name=".PushBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
